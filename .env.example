ANTHROPIC_API_KEY=

# Leave the rest empty to run locally: data goes to .data/pglite and there is no sign-in.

# Supabase > Connect > Transaction pooler (port 6543). Use the Session pooler (5432) for `npm run db:migrate`.
DATABASE_URL=
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Only these emails can use the app. Comma-separated.
ALLOWED_EMAILS=
# CLI only: your Supabase user id, so terminal runs appear in your app.
BACKCHANNEL_OWNER=
