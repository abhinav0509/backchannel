ANTHROPIC_API_KEY=

# Leave the rest empty to run locally: data goes to .data/pglite and there is no sign-in.

# Supabase > Connect > Transaction pooler (port 6543). Use the Session pooler (5432) for `npm run db:migrate`.
DATABASE_URL=
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admins: these emails sign in as the admin, who can invite people. Comma-separated.
ALLOWED_EMAILS=
# Supabase > Project Settings > API Keys > secret key. Server only: needed to send invitations.
SUPABASE_SECRET_KEY=
# Your Supabase user id: the admin, whose research has only the overall cap. The CLI writes as this user too.
BACKCHANNEL_OWNER=
